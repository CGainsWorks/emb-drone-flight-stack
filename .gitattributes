# Binary and large assets. Install Git LFS before cloning: git lfs install
*.pdf        filter=lfs diff=lfs merge=lfs -text
*.xlsx       filter=lfs diff=lfs merge=lfs -text

# KiCad files are text. Keep them diffable, never treat as binary.
*.kicad_pcb  text eol=lf
*.kicad_sch  text eol=lf
*.kicad_pro  text eol=lf
*.gbr        text eol=lf
*.drl        text eol=lf

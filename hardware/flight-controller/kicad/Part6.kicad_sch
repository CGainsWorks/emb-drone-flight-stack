	(text "Ref Pins:\nA6 - VBAT_ADC\nA5 - LED3 (OPT)\nA4 - LED2 (OPT)\nA3 - LED1 \nA2 - RSSI1\nA1 - RSSI2 (OPT)\nA0 - RSSI3 (OPT)\n\nD13 - SCK\nD11 - SDA\nD10 - CS\nD9 - DC\n\nD8 - Buzzer (Audio)\n\nD2 - (???) CH1 on RX5808 - OPT?\nD3 - (???) CH2 on RX5808 - OPT?\nD4 - (???) CH3 on RX5808 - OPT?\n\nD0 - SWRight or RX\nD1 - SWLeft or TX\nD12 - SWDown\nD7 - SWUp\n\nD5 - IN0\nD6 - IN1\n"
		(exclude_from_sim no)
		(at 249.682 162.814 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "09d151e1-0d1e-498f-9bbc-ef216af6b242")
	)
	(text "for gimbal"
		(exclude_from_sim no)
		(at 152.908 335.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0a7939b6-8900-488b-a9fb-426c0e113596")
	)
	(text "CVBS → ADV7180/ADV7280/TVP5150 (BT.656) →\n\nSTM32F7/H7 (DCMI + LTDC) → RGB TFT, or\n\nESP32-S3 (parallel in + RGB LCD) for modest resolutions, or\n\nRaspberry Pi (Zero 2/4) via USB AV capture → HDMI/DSI.\n\nAudio: RTC6715 AFOUT → I²S codec/ADC → SoC, or bypass SoC and go straight to an amp."
		(exclude_from_sim no)
		(at 174.498 447.802 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0ac42894-b329-4196-8c89-584f017303ec")
	)
